{
  "name": "nova-browser",
  "productName": "Nova Browser",
  "version": "1.3.2",
  "description": "A modern, DuckDuckGo-first Chromium desktop browser with built-in ad and tracker blocking.",
  "private": true,
  "author": "Nova Browser",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check internal-preload.js && node --check src/chrome.js && node --check src/internal.js && node --check src/icons.js && node --check lib/updater.js && node --check downloads-preload.js && node --check src/downloads-popover.js && node --check tools/prepare-logo.js && node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never",
    "prestart": "node tools/prepare-logo.js",
    "prebuild:win": "node tools/prepare-logo.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova Browser",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "internal-preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "downloads-preload.js",
      "tools/**/*",
      "build/logo.png",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Nova-Browser-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;WebBrowser",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NoobIsADev",
        "repo": "nova"
      }
    ],
    "portable": {
      "artifactName": "Nova-Browser-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
